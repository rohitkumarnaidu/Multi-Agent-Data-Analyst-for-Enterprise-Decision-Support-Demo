# === LLM API Keys ===
# OpenAI (for Orchestrator, Narrative & Validation agents)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (alternative to OpenAI — pick one)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === Kaggle (for dataset download) ===
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# === LLM Model Config ===
# Strong hosted model (for Orchestrator, Narrative, Validation agents)
STRONG_MODEL=gpt-4o-mini
# Local model via Ollama (for Data Retrieval, Analysis, Visualization agents)
LOCAL_MODEL=ollama/phi3:mini

# === Paths ===
RAW_DATA_DIR=./raw
CLEAN_DATA_DIR=./clean
FEATURES_DIR=./features
MODELS_DIR=./models
DUCKDB_PATH=./data/olist.duckdb

# === FastAPI ===
API_HOST=0.0.0.0
API_PORT=8000

# === Streamlit ===
STREAMLIT_PORT=8501
